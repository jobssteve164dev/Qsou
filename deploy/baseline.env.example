# 唯一对外端口；API 只在项目内部网络监听 8000。
QSOU_WEB_PORT=3000

# 浏览器不直接访问 API；保留空 CORS 允许列表。
QSOU_CORS_ORIGINS=[]

# 基线登录账号。生产环境必须替换为独立强密码与随机密钥。
QSOU_ADMIN_USERNAME=admin
QSOU_ADMIN_PASSWORD=change-this-password
QSOU_SECRET_KEY=change-this-secret-key
QSOU_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 持续采集器：留空表示运行全部登记来源，也可用逗号分隔 source_id 做灰度运行。
QSOU_SOURCE_IDS=
QSOU_CRAWL_POLL_SECONDS=60
QSOU_ADAPTER_MAX_DETAILS=12

# PostgreSQL 是唯一目录库；由 GitOps 注入正式密钥。
DATABASE_URL=
QSOU_OBJECT_STORAGE_BACKEND=file
QSOU_OBJECT_STORAGE_ENDPOINT=
QSOU_OBJECT_STORAGE_REGION=us-east-1
QSOU_OBJECT_STORAGE_BUCKET=
QSOU_OBJECT_BACKUP_BUCKET=
QSOU_OBJECT_STORAGE_ACCESS_KEY=
QSOU_OBJECT_STORAGE_SECRET_KEY=

# Elasticsearch 是常驻、可重建的全文检索派生层。
ENABLE_ELASTICSEARCH=true
ENABLE_QDRANT=false
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=qsou_
